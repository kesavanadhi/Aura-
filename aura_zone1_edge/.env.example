# AURA Zone 1 AI Edge Server Configuration
NODE_ID=esp32_node1
ZONE_NAME="Zone 1 (Bedroom + Hallway)"

# MQTT Broker Details
MQTT_BROKER=172.16.133.140
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_RECONNECT_DELAY=3

# Thresholds
LDR_DARK_THRESHOLD_LUX=350
LDR_BRIGHT_THRESHOLD_LUX=650
